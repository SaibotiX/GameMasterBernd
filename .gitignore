# --- Credentials -----------------------------------------------------------
# Written by `pi-ai login` (OAuth access/refresh tokens) — never commit.
auth.json
.env
.env.*
.env~
*.pem
*.key
credentials.json

# --- Runtime state ---------------------------------------------------------
# The ledger and everything the game downloads. Recreated on first run.
data/

# --- Dependencies ----------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo

# --- Local tooling / editor ------------------------------------------------
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.vscode/
.idea/
*.swp
.DS_Store

# --- Box-local friend machinery (new-friend.sh) -----------------------------
# One door + one service per friend — secret paths and auth hashes live on
# the box only; the tracked tree never carries a friend.
deploy/host/compose.override.yaml
deploy/host/caddy/friends/*.caddy
!deploy/host/caddy/friends/.keep.caddy
# localcheck.sh's throwaway store (recorded play, even test play, never lands
# in the tree)
deploy/host/.localcheck-store.*
# localcheck's other scratch dirs (crash leftovers must never enter the tree)
deploy/host/.localcheck-fragment.*
deploy/host/.localcheck-backup.*
# The house lane's box-local state: virtual keys + the usage ledger (R12/R29).
# Same custody as the friend files — the tracked tree never carries a key.
deploy/host/gateway-state/
deploy/host/.localcheck-gateway.*
# The consent register (02 item 9, R13/R20): who agreed, when, over which
# channel — personal data, box-local like every friend fact.
deploy/host/consents.md
# R16's first-use archive: the site as first served, rendered — the Impressum
# copy carries R19's address, which never enters the repo (the Caddyfile's
# law); box-local beside the consent register.
deploy/host/first-use/

# --- Playtest telemetry ----------------------------------------------------
# Testers' session drops are private play data; reports stay tracked.
# (human batches under research/analysis/, AI batches under aitester/;
# store-mirror is the analysis machine's pull of the hosted store — R13)
research/analysis/sessions-in/
research/analysis/store-mirror/
aitester/sessions-in/
