# --- Credentials -----------------------------------------------------------
# Written by `pi-ai login` (OAuth access/refresh tokens) — never commit.
auth.json
.env
.env.*
*.pem
*.key
credentials.json

# --- Runtime state ---------------------------------------------------------
# The ledger and everything the game downloads. Recreated on first run.
data/

# --- Vendored binaries -----------------------------------------------------
# Static ffmpeg (~420 MB); place a build at tools/ffmpeg/ffmpeg.
# (tools/yt-dlp is a tracked git submodule — do not widen this to tools/.)
tools/ffmpeg/

# --- Dependencies ----------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo

# --- Local tooling / editor ------------------------------------------------
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.vscode/
.idea/
*.swp
.DS_Store

# --- Playtest telemetry ----------------------------------------------------
# Testers' session drops are private play data; reports stay tracked.
# (human batches under research/analysis/, AI batches under aitester/)
research/analysis/sessions-in/
aitester/sessions-in/
