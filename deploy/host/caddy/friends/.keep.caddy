# Friends' doors land here as <name>.caddy, written by new-friend.sh on the
# box and gitignored (secret path + auth hash — never tracked). This file
# keeps the directory in git and the import glob non-empty. The shape each
# snippet carries, for the record:
#
#   redir /f/<token> /f/<token>/ 308
#   handle_path /f/<token>/* {
#   	basic_auth {
#   		<name> <bcrypt-hash>
#   	}
#   	reverse_proxy wc-<name>:7681
#   }
