# Stage-1 Caddyfile — worldconsole.eu at INWX, DNS plain and unproxied (R17).
# TLS is automatic (Let's Encrypt); WebSocket pass-through is Caddy's normal
# reverse_proxy behavior, nothing to configure. Each friend gets one
# long-random secret path plus a basic-auth pair — both minted by
# new-friend.sh, pasted under the marker.

{
	# ACME account mailbox; set ACME_EMAIL in .env beside compose.yaml.
	email {$ACME_EMAIL}
}

play.worldconsole.eu {
	encode zstd gzip

	# Friends' doors: one box-local snippet each in friends/<name>.caddy,
	# written by new-friend.sh, gitignored — the tracked tree never carries
	# a friend. The tracked .keep.caddy keeps the glob non-empty.
	import friends/*.caddy

	# Unmatched paths, including / — there is no directory of doors.
	handle {
		respond "World Console — by invitation." 404
	}
}

# R11's isolated credential origin: reserved from day one, served only when
# the vault round builds it. Nothing else may ever share this origin.
vault.worldconsole.eu {
	respond "not yet" 404
}

worldconsole.eu {
	# The landing/disclosure page (02 item 9) lands here before the first
	# friend plays; until then the root only proves the name resolves.
	respond "World Console" 200
}
