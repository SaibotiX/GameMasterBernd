# The local end-to-end check's Caddyfile (localcheck.sh drives it): the
# production shape — TLS, secret path, basic auth, WebSocket proxy — with
# self-signed certs and one fixed test doorway. The token and password here
# are TEST FIXTURES, deliberately public; real doors are minted by
# new-friend.sh and never look like this.

{
	local_certs
	auto_https disable_redirects
}

localhost, 127.0.0.1 {
	encode zstd gzip

	redir /f/localtest00000000000000000000 /f/localtest00000000000000000000/ 308
	handle_path /f/localtest00000000000000000000/* {
		basic_auth {
			# test / local-test-password
			test $2a$14$Z/1Vc95yNgexVZApQgZHbOkDfgPwBKiwYF2fFp9w8LHQS3supWk8u
		}
		# Same two-upstream shape new-friend.sh mints: sleeping container →
		# the waker's page (02 item 12). dial_timeout bounds the whole dial
		# INCLUDING the DNS lookup — a stopped container's name can hang in
		# resolution (machines with broken upstream DNS answer slowly, not
		# NXDOMAIN), and an unbounded lookup would eat the try window before
		# the waker is ever consulted.
		reverse_proxy wc-test:7681 waker:9000 {
			lb_policy first
			lb_try_duration 4s
			lb_try_interval 250ms
			fail_duration 3s
			header_up X-Friend test
			transport http {
				dial_timeout 1500ms
			}
		}
	}

	handle {
		respond "World Console — by invitation." 404
	}
}

# The landing ground's local mirror (02 items 9+11): the exact production
# block from caddy/Caddyfile on its own local hostname — localcheck curls
# it via --resolve and proves the words, the templates-rendered address
# (a test fixture here) and the headers before any of it faces the box.
site.localhost {
	encode zstd gzip
	root * /srv/site
	templates
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'"
	}
	file_server
}
