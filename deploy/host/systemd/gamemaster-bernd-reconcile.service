# R12/R6's nightly reconciliation — the gateway's ledger checked against
# pi's own per-turn cost stamps; a mismatch is a red unit and a ntfy ping.
# Installed by: cp to /etc/systemd/system/, daemon-reload, enable --now the timer.
[Unit]
Description=GameMaster Bernd ledger reconciliation (gateway meter vs pi cost stamps)
Requires=docker.service
After=docker.service
# The pager (runbook §the pager): reconcile's own mismatch ping tells the
# details; OnFailure catches the script CRASHING before it can speak.
OnFailure=gamemaster-bernd-alert@%n.service

[Service]
Type=oneshot
ExecStart=/home/deploy/gamemaster-bernd/deploy/host/reconcile.sh
