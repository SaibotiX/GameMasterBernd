# The pager's red half — runbook §the pager: fired by OnFailure= on the
# nightly units, instance %i carrying the failed unit's own name. The ping
# speaks ops only (unit names, never play); the topic name stays the box
# .env's secret, sourced the same proven way reconcile.sh reads it.
# Installed by: cp to /etc/systemd/system/, daemon-reload (templates need
# no enable — OnFailure= starts them by name).
[Unit]
Description=GameMaster Bernd failure page (%i) — ntfy ping to the maintainer

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'set -a; . /home/deploy/gamemaster-bernd/deploy/host/.env; set +a; [ -n "$$NTFY_TOPIC" ] || { echo "alert: no NTFY_TOPIC — journal only"; exit 0; }; curl -fsS -m 10 -X POST -H "title: GameMaster Bernd — %i went red" -H "priority: high" -H "tags: rotating_light" -d "the box reports %i failed; check journalctl -u %i when you can" "https://ntfy.sh/$$NTFY_TOPIC"'
