# Nightly, after the 04:17 store sweep has compacted the day's sessions;
# Persistent so a rebooted box catches up its missed night.
[Unit]
Description=Nightly GameMaster Bernd backup (02 item 13)

[Timer]
OnCalendar=*-*-* 05:11:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
